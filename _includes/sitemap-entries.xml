{%- assign sitemap_lang = include.lang | default: site.default_lang -%}
{%- assign sitemap_posts = site.posts_by_lang[sitemap_lang] -%}
{%- comment -%}
  Thin-content remediation: only index substantive pages (home, about,
  privacy, posts). List/search/tag/year/pagination URLs stay reachable
  but are noindex + excluded from the sitemap.
{%- endcomment -%}
{%- if sitemap_lang == site.default_lang -%}
<url><loc>{{ site.url }}/</loc></url>
<url><loc>{{ site.url }}/about/</loc></url>
<url><loc>{{ site.url }}/privacy-policy/</loc></url>
{%- else -%}
<url><loc>{{ site.url }}/{{ sitemap_lang }}/</loc></url>
<url><loc>{{ site.url }}/{{ sitemap_lang }}/about/</loc></url>
<url><loc>{{ site.url }}/{{ sitemap_lang }}/privacy-policy/</loc></url>
{%- endif -%}
{%- for post in sitemap_posts -%}
<url>
<loc>{{ post.url | absolute_url }}</loc>
<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
</url>
{%- endfor -%}
