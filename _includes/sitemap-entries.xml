{%- assign sitemap_lang = include.lang | default: site.default_lang -%}
{%- assign sitemap_posts = site.posts_by_lang[sitemap_lang] -%}
{%- if sitemap_lang == site.default_lang -%}
<url><loc>{{ site.url }}/</loc></url>
<url><loc>{{ site.url }}/archive/</loc></url>
{%- else -%}
<url><loc>{{ site.url }}/{{ sitemap_lang }}/</loc></url>
<url><loc>{{ site.url }}/{{ sitemap_lang }}/archive/</loc></url>
{%- endif -%}
{%- for post in sitemap_posts -%}
<url>
<loc>{{ post.url | absolute_url }}</loc>
<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
</url>
{%- endfor -%}
{%- if sitemap_lang == site.default_lang -%}
{%- for tag in site.tags -%}
<url><loc>{{ site.url }}/archive/tag/{{ tag[0] | slugify }}/</loc></url>
{%- endfor -%}
{%- assign years = '' | split: '' -%}
{%- for post in sitemap_posts -%}
{%- assign year = post.date | date: '%Y' -%}
{%- unless years contains year -%}
{%- assign years = years | push: year -%}
<url><loc>{{ site.url }}/archive/{{ year }}/</loc></url>
{%- endunless -%}
{%- endfor -%}
{%- assign page_count = sitemap_posts.size | plus: site.posts_per_page | minus: 1 | divided_by: site.posts_per_page -%}
{%- for i in (2..page_count) -%}
<url><loc>{{ site.url }}/page/{{ i }}/</loc></url>
{%- endfor -%}
{%- else -%}
{%- assign years = '' | split: '' -%}
{%- for post in sitemap_posts -%}
{%- assign year = post.date | date: '%Y' -%}
{%- unless years contains year -%}
{%- assign years = years | push: year -%}
<url><loc>{{ site.url }}/{{ sitemap_lang }}/archive/{{ year }}/</loc></url>
{%- endunless -%}
{%- endfor -%}
{%- assign page_count = sitemap_posts.size | plus: site.posts_per_page | minus: 1 | divided_by: site.posts_per_page -%}
{%- for i in (2..page_count) -%}
<url><loc>{{ site.url }}/{{ sitemap_lang }}/page/{{ i }}/</loc></url>
{%- endfor -%}
{%- endif -%}