{%- assign feed_lang = include.lang | default: site.default_lang -%}
{%- assign feed_meta = site.data.languages[feed_lang] -%}
{%- assign feed_posts = site.posts_by_lang[feed_lang] -%}
{%- if feed_lang == site.default_lang -%}
{%- assign feed_self = '/rss.xml' -%}
{%- else -%}
{%- assign feed_self = '/' | append: feed_lang | append: '/rss.xml' -%}
{%- endif -%}
    <channel>
        <title>{{ site.title }}</title>
        <link>{{ site.url }}{% if feed_lang != site.default_lang %}/{{ feed_lang }}{% endif %}</link>
        <description>{{ feed_meta.description | strip_newlines | strip | xml_escape }}</description>
        <language>{{ feed_lang }}</language>
        <lastBuildDate>{{ site.time | date_to_xmlschema }}</lastBuildDate>
        <atom:link href="{{ feed_self | absolute_url }}" rel="self" type="application/rss+xml" />
        {% for post in feed_posts %}
        <item>
            <title>{{ post.title | xml_escape }}</title>
            <link>{% if post.link %}{{ post.link }}{% else %}{{ site.url }}{{ post.url }}{% endif %}</link>
            <description>{{ post.description | default: post.meta | xml_escape }}</description>
            <guid>{% if post.link %}{{ post.link }}{% else %}{{ site.url }}{{ post.url }}{% endif %}</guid>
            <pubDate>{{ post.date | date_to_xmlschema }}</pubDate>
            {% if post.image %}
            <enclosure url="{{ post.image | absolute_url }}" type="image/webp" />
            <media:content url="{{ post.image | absolute_url }}" medium="image" />
            {% endif %}
        </item>
        {% endfor %}
    </channel>